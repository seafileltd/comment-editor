    "pull-translate": "tx pull -f",
    "pub:optimized": "rm dist/config.js",
    "prepublishOnly": "npm run clean && npm run pub:dist",
    "test": "node scripts/test.js",
    "release": "release-it",
    "prepare": "husky install",
    "lint": "lint-staged"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --ext .tsx,.ts,.js ./src",
      "git add"
    ]
  },
  "files": [
    "dist/",
    "public/",
    "TODO.md"
